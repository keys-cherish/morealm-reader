<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <application
        android:name=".MoRealmApp"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.MoRealm.Splash"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".ui.navigation.MainActivity"
            android:alwaysRetainTaskState="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="uiMode|screenSize|screenLayout|orientation|smallestScreenSize|density"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Foldable: allow activity to resize freely across displays -->
            <meta-data android:name="android.supports_size_changes" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 文件打开走独立透明 FileOpenActivity（见下方），此处不再声明 VIEW filter。 -->
            <!-- Continue reading shortcut -->
            <intent-filter>
                <action android:name="com.morealm.app.CONTINUE_READING" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            外部「打开方式」文件入口（透明）。系统/文件管理器/MT/网盘/QQ/微信用 MoRealm 打开书籍
            文件时 VIEW intent 落到这里：复制入私有存储 + 静默入库 → 跳 MainActivity 打开阅读器。
            双 intent-filter：Filter1 = 来源已知 mimeType（含 octet-stream 兜底微信/QQ 的 content://）；
            Filter2 = */* + pathPattern 按扩展名（文件管理器 file:// 无 mimeType 时）。两者互补覆盖各来源。
        -->
        <activity
            android:name=".ui.navigation.FileOpenActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.MoRealm.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/x-mobipocket-ebook" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:host="*" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.txt" />
                <data android:pathPattern=".*\\.TXT" />
                <data android:pathPattern=".*\\.epub" />
                <data android:pathPattern=".*\\.EPUB" />
                <data android:pathPattern=".*\\.pdf" />
                <data android:pathPattern=".*\\.PDF" />
                <data android:pathPattern=".*\\.mobi" />
                <data android:pathPattern=".*\\.MOBI" />
                <data android:pathPattern=".*\\.azw" />
                <data android:pathPattern=".*\\.azw3" />
                <data android:pathPattern=".*\\.zip" />
                <data android:pathPattern=".*\\.umd" />
            </intent-filter>
        </activity>

        <!--
            数据库恢复入口。仅由 MainActivity / 进程重启 launcher Intent 触发，
            不暴露给其他 app（exported=false）。launchMode=singleTask 防止重复栈起。
        -->
        <activity
            android:name=".ui.recovery.RecoveryActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="screenSize|screenLayout|orientation|smallestScreenSize|density" />

        <!--
            脚本交互式 WebView 入口。仅由书源登录脚本 (SourceLoginScriptApi.showBrowser) 拉起，
            不暴露给外部 (exported=false)。扫码登录 / 图形验证码 / 滑块验证类场景必须有 UI。
            launchMode=singleTop 避免用户在登录中途再次触发同一脚本导致栈里堆两个。
        -->
        <activity
            android:name=".ui.source.ShowBrowserActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="uiMode|screenSize|screenLayout|orientation|smallestScreenSize|density" />

        <service
            android:name=".service.TtsService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <service
            android:name=".service.CacheBookService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".service.CheckSourceService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            SAF 批量导入前台服务 — v1.6 修复"6000 本一次性导入书架为空"。
            前台化保证导入 10-20 分钟内不被 OEM / 系统 OOM 杀掉；通知栏可见 progress。
            详见 service/ImportService.kt KDoc。
        -->
        <service
            android:name=".service.ImportService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          桌面小组件「继续阅读」receiver。
          android:enabled 通过 @bool/widget_supported 资源守卫：
            - res/values/widget_bools.xml = false  → API < 23 设备禁用
            - res/values-v23/widget_bools.xml = true → API 23+ 启用
          这样在 minSdk=21 的低版本设备上系统不会实例化 Glance receiver，
          避免 Glance 1.1.x 内部对 API 23+ 的依赖触发 ClassNotFoundException。
        -->
        <receiver
            android:name=".widget.ContinueReadingWidgetReceiver"
            android:exported="false"
            android:enabled="@bool/widget_supported"
            android:label="@string/widget_continue_reading_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_continue_reading_info" />
        </receiver>

    </application>

    <!--
      Android 11+ (API 30) 包可见性沙箱：要让 TextToSpeech 能绑到设备上安装的 TTS 引擎
      进程（系统自带 Google TTS、multitts、讯飞 TTS 等），必须在这里显式声明 TTS_SERVICE
      意图。否则 `TextToSpeech(ctx, listener)` 构造时找不到任何可绑服务，OnInitListener
      立即收到 status=ERROR(-1)，引擎列表 `tts.engines` 也是空 —— 表现为 "系统未识别到
      可用的 TTS 引擎"，无论用户装了什么 TTS APK 都看不见。
      参考：Legado app/src/main/AndroidManifest.xml 同样的写法。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

</manifest>
